# --- Local agent-network scaffolding (never publish) ---
.anet/
.mcp.json

# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Kernel payload ---
# Installed by `npm run kernel:install` from the version pinned in upstream.lock.json,
# which is the thing under version control. The tree itself is a build artefact.
resources/kernel/

# --- Build output ---
# electron-builder writes the unpacked Linux dir, the .deb, the .AppImage, and
# debug files into release/. `out/` and `dist/` are conventional names other
# build steps might use.
out/
dist/
build/
release/
release-unpacked/
linux-unpacked/
# debian/ 是 build-deb.sh 的打包暂存目录（构建产物，一律不入库）。
# 维护者脚本的源码单列在 packaging/DEBIAN/ 下入库——不能放这里，因为打包
# 第一步就是 rm -rf debian/，放这儿会被自己删掉（详见 build-deb.sh 注释）。
# 此前那套「!debian/DEBIAN/postinst」豁免只解决了一半问题：文件确实进了仓库，
# 但打包时 cp 依然失败，实际进包的始终是 heredoc 兜底版。
debian/
*.tsbuildinfo

# --- electron-builder / Electron cache ---
# Downloaded Electron zips, fpm binaries, and 7zip are reused between builds but
# should not enter the source tree.
electron-builder-cache/
*.AppImage
*.deb
*.rpm
*.snap
*.snap.*
builder-debug.yml
builder-effective-config.yaml
latest-linux.yml
latest.yml
nsis/

# --- Temporary files from the build / verification run ---
# Anything left in /tmp-style scratch locations of the project root.
tmp/
scratch/
.cache/
.tmp/
*.tmp
*.temp
.cache-*
*.tgz
*.tar.gz
*.zip
*.bak
*.orig
*.rej

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Test & coverage ---
coverage/
.vitest/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Logs ---
logs/
*.log
npm-debug.log*

# --- TypeScript / prebuilt binary detritus ---
.tsbuildinfo
.tsdown-cache/
*.tsbuildinfo

# 竞品预警脚本的运行状态（本地生成，不入库）
.watch-competitor-state.json
