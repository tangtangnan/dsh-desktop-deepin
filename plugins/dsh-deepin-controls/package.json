{
  "name": "dsh-deepin-controls",
  "version": "0.0.1",
  "private": true,
  "description": "Minimal proof-of-concept pseudo Desktop Host plugin: verifies the patch/insert mount path works on this machine",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
